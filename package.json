{
  "name": "fhir-patient-explorer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web run dev",
    "dev:api": "pnpm --filter api run dev",
    "dev:web": "pnpm --filter web run dev",
    "typecheck": "pnpm --filter api --filter web run typecheck",
    "typecheck:api": "pnpm --filter api run typecheck",
    "typecheck:web": "pnpm --filter web run typecheck",
    "test": "pnpm --filter api --filter web run test",
    "test:api": "pnpm --filter api run test",
    "test:web": "pnpm --filter web run test",
    "test:e2e": "pnpm --filter api run test:e2e",
    "lint": "pnpm --filter api --filter web run lint",
    "test:browser": "pnpm --filter web run test:browser"
  }
}
